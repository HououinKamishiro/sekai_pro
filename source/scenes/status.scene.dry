[? if z_party_name == "CVP": <span class="tooltip-text" title="Christian People's Party" style="color: #000000;">**[+ z_party_name +]**</span>: [? if industrial_z_backing == 3: high?][? if industrial_z_backing == 4: highest?]  ?]

[? if not vs_formed: [? if ddp_name == "DStP": <span class="tooltip-text" title="German State Party" style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if ddp_name == "DDP": <span class="tooltip-text" title="German Democratic Party" style="color: #D3C24D;">**[+ ddp_name +]**</span>?]: [? if industrial_ddp_backing == 0: none?][? if industrial_ddp_backing == 1: low?][? if industrial_ddp_backing == 2: medium?]  ?]

[? if vs_formed: <span class="tooltip-text" title="Virtual Singers" style="color: #86cecb;">**VS**</span>: [? if industrial_vs_backing == 2: medium?][? if industrial_vs_backing == 3: high?][? if industrial_vs_backing == 4: highest?] ?]

[? if not vs_formed and vbs_exist: <span class="tooltip-text" title="Vivid Bad Squad" style="color: #ee1166;">**VBS**</span>: [? if industrial_vbs_backing == 1: low?][? if industrial_vbs_backing == 2: medium?][? if industrial_vbs_backing == 3: high?] ?]

[? if not cvp_formed and not mmj_defunct: <span class="tooltip-text" title="More More Jump" style="color: #6ccb20;">**MMJ**</span>: [? if industrial_mmj_backing == 4: highest?][? if industrial_mmj_backing == 3: high?][? if industrial_mmj_backing == 2: medium?][? if industrial_mmj_backing == 1: low?][? if industrial_mmj_backing == 0: [? if mmj_ideology == "Moderate": none?][? if mmj_ideology == "Radical": Hugenberg funded?]?]?]

[? if mmj_ideology == "Moderate": <span class="tooltip-text" title="German National Front" style="color: #003755;">**DNF**</span>: Hugenberg funded ?]

[? if kvp_formed and not mmj_vbs_formed: <span class="tooltip-text" title="Conservative People's Party" style="color: #0087DC;">**KVP**</span>: high ?]

[? if mmj_vbs_formed: <span class="tooltip-text" title="Free Conserative Party" style="color: #00C0FF;">**FKP**</span>: high ?] 

[? if dsu_exist: <span class="tooltip-text" title="German Social Union" style="color: #6A1E1E;">**DSU**</span>: none ?]

<span class="tooltip-text" title="Nightcord at 25" style="color: #884499;">**N25**</span>: [? if industrial_n25_backing == 0: none?][? if industrial_n25_backing == 1: low?][? if industrial_n25_backing == 2: medium?]

[? if nvf_exist: <span class="tooltip-text" title="National People's Front" style="color: #142e20;">**NVF**</span>: none ?]

= Internal Factions of the <span style="color: #ff9900;">**WxS**</span>

{!<span class="tooltip-text" title="The Left is interested in radical, transformative policies and cooperation with the LN.">Left</span>!} strength: [+ left_strength : strength +], dissent: [+ left_dissent : dissent +]

{!<span class="tooltip-text" title="The Center is a faction of Center Marxists, between reform and revolution.">Center</span>!} strength: [+ center_strength : strength +], dissent: [+ center_dissent : dissent +]

{!<span class="tooltip-text" title="Labor's goal is economic reform and benefits for organized workers.">Labor</span>!} strength: [+ labor_strength : strength +], dissent: [+ labor_dissent : dissent +]

{!<span class="tooltip-text" title="Reformists are pragmatic participants in government, and seek to expand the welfare state and defend democracy.">Reformist</span>!} strength: [+ reformist_strength : strength +], dissent: [+ reformist_dissent : dissent +]

[? if neorevisionism: {!<span class="tooltip-text" title="Neorevisionists focus on defending the republic and expanding democracy, supporting new propaganda methods and extra-parliamentary action">Neorevisionist</span>!} strength: [+ neorevisionist_strength : strength +], dissent: [+ neorevisionist_dissent : dissent +] ?]

@paramilitaries
on-arrival: {!
Q.rb_strength_2 = Q.rb_strength.toFixed(1);
Q.rfb_strength_2 = Q.rfb_strength.toFixed(1);
Q.sh_strength_2 = Q.sh_strength.toFixed(1);
Q.sa_strength_2 = Q.sa_strength.toFixed(1);
!}

